<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <GameFilesDir Condition="'$(GameFilesDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Game_Files')">$(MSBuildThisFileDirectory)..\..\..\Game_Files</GameFilesDir>
    <GameFilesDir Condition="'$(GameFilesDir)' == ''">C:\Users\User\Desktop\SDVport Version\Game_Files</GameFilesDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\lib\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GameFilesDir)\StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GameFilesDir)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameFilesDir)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(GameFilesDir)\xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="SyncEmbeddedModResources" AfterTargets="Build">
    <PropertyGroup>
      <EmbeddedModDir>$(MSBuildThisFileDirectory)..\..\SDViOS\Resources\Mods\SDViOSTouchControls</EmbeddedModDir>
    </PropertyGroup>
    <MakeDir Directories="$(EmbeddedModDir)" Condition="!Exists('$(EmbeddedModDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EmbeddedModDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)manifest.json" DestinationFolder="$(EmbeddedModDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
