<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-ios17.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TargetPlatformIdentifier>ios</TargetPlatformIdentifier>

    <!-- Disable EOL workload errors on newer runner SDKs -->
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- Ad-hoc signing for sideloading (TrollStore, AltStore, Sideloadly) -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>

    <!-- Mono Interpreter enabled for dynamic assembly execution (SMAPI & mods) -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchLink>None</MtouchLink>
    <PublishTrimmed>false</PublishTrimmed>

    <ApplicationTitle>Stardew Valley</ApplicationTitle>
    <ApplicationId>com.deadakj.sdvios</ApplicationId>
    <ApplicationVersion>1.6.15</ApplicationVersion>
    <ApplicationDisplayVersion>1.6.15</ApplicationDisplayVersion>

    <!-- Enable task debugging / JIT execution where available -->
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.1.303" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" />
    <None Include="Entitlements.plist" />
  </ItemGroup>
</Project>
